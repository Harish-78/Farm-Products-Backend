# ==============================================================================
# Backend Environment Variables (.env.example)
# ==============================================================================

# Server & Environment
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS & Redirects (e.g. https://farm-products-frontend.vercel.app or http://localhost:5173)
FRONTEND_URL=
CLIENT_URL=

# Cookie Name for Authentication (defaults to 'token' if omitted)
AUTH_COOKIE_NAME=token

# Database Connection (Neon PostgreSQL connection string)
DATABASE_URL=

# JWT Secret & Expiry
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Nodemailer / Email Service
EMAIL_USER=
EMAIL_PASS=
